# Copy to .env.production and replace every placeholder before shipping.
RFID_MIDDLEWARE_ID=WH-A-GATE-01
RFID_API_TOKEN=replace-with-real-middleware-token
RFID_DATABASE_USER=rfid
RFID_DATABASE_PASSWORD=replace-with-strong-password

# Direct VPS mode: the backend sends complete manifests to this middleware API.
RFID_MANIFEST_MODE=Push
RFID_API_PORT=8080
RFID_API_BIND_ADDRESS=0.0.0.0

# Pull mode only: set RFID_MANIFEST_MODE=Pull and provide the shared backend URL.
# RFID_SERVER_BASE_URL=https://replace-me.example

# Default production reader transport is outbound TCP. Use TcpListener with
# docker-compose.listener.yml when the reader must initiate the connection.
RFID_READER_MODE=Vendor
RFID_READER_TRANSPORT=Tcp
RFID_READER_ADDRESS=192.168.1.223
RFID_READER_PORT=1969
# Listener mode only. Restrict this port with the host/cloud firewall; do not
# rely on the bind address as an authentication mechanism.
# RFID_READER_BIND_ADDRESS=0.0.0.0
# Optional RF power for every antenna, in dBm (1-33). Omit for reader-stored power.
# RFID_READER_ANTENNA_POWER=10
RFID_READER_ALARM_MODE=BuzzerAndDigitalOutput1

# Serial override settings, used only with docker-compose.serial.yml.
# RFID_SERIAL_DEVICE=/dev/serial/by-id/replace-me
# RFID_DIALOUT_GID=20
# RFID_READER_BAUD=115200
# RFID_READER_RS485_ADDRESS=0
