{
  "info": {
    "_postman_id": "5de70e28-997c-44e0-a157-9831a6034138",
    "name": "RFID Middleware Public API",
    "description": "Complete public HTTP API collection for the RFID middleware. The prepared ACTIVE manifest authorizes E280699500004005F0A661BB and E28068940000503673E52C79. Set apiToken before sending protected requests. Internal operational endpoints are intentionally unavailable on the public port and are accessed only through the server's Unix control socket.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
