# Copy this file to .env for local WSL testing. Never commit real production credentials.

# Middleware identity and backend API authentication
RFID_API_TOKEN=dev-token
RFID_Id=WH-A-GATE-01
RFID_Server__BaseUrl=http://127.0.0.1:5080

# Local PostgreSQL used only by the middleware. Scan data remains here.
RFID_DatabaseConnectionString='Host=127.0.0.1;Port=5432;Database=rfid_edge;Username=rfid;Password=rfid-dev-password'

# PostgreSQL used by the test backend for manifests and revocation audit.
ConnectionStrings__MockServer='Host=127.0.0.1;Port=5432;Database=rfid_backend;Username=rfid;Password=rfid-dev-password'

# Safe default for development. Change to Vendor only when commissioning hardware.
RFID_ReaderMode=ManagedFake

# Real serial reader after usbipd exposes it to WSL. Prefer /dev/serial/by-id/...
# when that stable path exists; /dev/ttyUSB0 is the usual fallback.
RFID_VendorReader__Transport=Serial
RFID_VendorReader__SerialDevice=/dev/ttyUSB0
RFID_VendorReader__Baud=115200
RFID_VendorReader__Rs485Address=0
RFID_VendorReader__ReaderId=2609030071
# Optional RF power for every antenna, in dBm (1-33). Omit for reader-stored power.
# RFID_VendorReader__AntennaPower=10
RFID_VendorReader__AlarmMode=BuzzerAndDigitalOutput1
RFID_VendorReader__AlarmPulseMilliseconds=1000

# Vendor Linux x86-64 libraries. Source this file from the repository root.
RFID_NATIVE_DIR="$(pwd)/linux/x86_64/release"
LD_LIBRARY_PATH="$(pwd)/linux/x86_64/release"

# Unix control socket must be on the WSL Linux filesystem, not /mnt/d.
RFID_ControlSocket=/tmp/rfid-middleware-dev/control.sock

# Optional PostgreSQL integration-test connection. Tests create isolated schemas.
RFID_TEST_POSTGRES='Host=127.0.0.1;Port=5432;Database=rfid_edge;Username=rfid;Password=rfid-dev-password'
