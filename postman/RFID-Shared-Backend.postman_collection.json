{
  "info": {
    "_postman_id": "39cfb68a-a02d-4b3d-93fd-5a666330fefb",
    "name": "RFID Shared Backend Flow",
    "description": "Exercises the single shared backend used by the mobile app and RFID middleware. Run in order. The full collection validates the backend contract; for physical-reader acceptance, send requests one at a time and wait for middleware synchronization between mutations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Backend health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/healthz",
        "description": "Confirms that the shared test backend is reachable through the SSH tunnel."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Backend is healthy', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('healthy');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Reset development backend",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/admin/reset?count=2",
        "description": "Development only. Clears mock-backend state and restores seeded credentials. Never expose this route in production."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Development backend reset succeeded', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.environment.unset('etag');"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Publish initial active manifest",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"manifestId\": \"{{manifestId}}\",\n  \"transportId\": \"{{transportId}}\",\n  \"version\": {{currentVersion}},\n  \"count\": 2,\n  \"expiresMinutes\": 1440,\n  \"items\": [\n    {\n      \"inventoryId\": \"POSTMAN-ITEM-001\",\n      \"epc\": \"{{authorizedEpc}}\"\n    },\n    {\n      \"inventoryId\": \"POSTMAN-ITEM-002\",\n      \"epc\": \"{{secondAuthorizedEpc}}\"\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/admin/middleware/{{middlewareId}}/manifest/activate",
        "description": "Development-only initial publication. A timestamp-based version keeps repeated test runs newer than prior middleware state."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('currentVersion', String(Date.now()));",
              "pm.environment.set('authorizeRequestId', pm.variables.replaceIn('{{$guid}}'));",
              "pm.environment.set('revokeRequestId', pm.variables.replaceIn('{{$guid}}'));",
              "pm.environment.set('completeRequestId', pm.variables.replaceIn('{{$guid}}'));",
              "pm.environment.unset('etag');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Initial manifest was published', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.manifestId).to.eql(pm.environment.get('manifestId'));",
              "  pm.expect(String(json.version)).to.eql(pm.environment.get('currentVersion'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Middleware downloads active manifest",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{middlewareToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/middleware/{{middlewareId}}/manifest",
        "description": "The real middleware polls this route using its middleware-role bearer token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Active manifest matches the published version', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('ACTIVE');",
              "  pm.expect(json.manifestId).to.eql(pm.environment.get('manifestId'));",
              "  pm.expect(json.itemCount).to.eql(2);",
              "  pm.expect(json.items).to.have.length(2);",
              "  pm.environment.set('currentVersion', String(json.version));",
              "});",
              "pm.test('Manifest response has an ETag', function () {",
              "  const etag = pm.response.headers.get('ETag');",
              "  pm.expect(etag).to.be.ok;",
              "  pm.environment.set('etag', etag);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Middleware receives 304 for unchanged manifest",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{middlewareToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [
          { "key": "If-None-Match", "value": "{{etag}}" }
        ],
        "url": "{{baseUrl}}/api/v1/middleware/{{middlewareId}}/manifest",
        "description": "Confirms ETag-based polling when no manifest change exists."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unchanged manifest returns 304', function () {",
              "  pm.response.to.have.status(304);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Mobile authorizes an additional EPC",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{mobileToken}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"{{authorizeRequestId}}\",\n  \"expectedVersion\": {{currentVersion}},\n  \"inventoryId\": \"POSTMAN-EXTRA-001\",\n  \"epc\": \"{{extraEpc}}\",\n  \"note\": \"Authorized from Postman\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/mobile/middleware/{{middlewareId}}/manifests/{{manifestId}}/items/authorize",
        "description": "Mobile mutation on the same shared backend. It creates the next immutable manifest version."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authorize created the next version', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.alreadyApplied).to.eql(false);",
              "  pm.expect(json.epc).to.eql(pm.environment.get('extraEpc').toUpperCase());",
              "  pm.environment.set('currentVersion', String(json.newVersion));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Middleware downloads authorized version",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{middlewareToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [
          { "key": "If-None-Match", "value": "{{etag}}" }
        ],
        "url": "{{baseUrl}}/api/v1/middleware/{{middlewareId}}/manifest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authorized version contains the additional EPC', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('ACTIVE');",
              "  pm.expect(json.items.map(function (item) { return item.epc; })).to.include(pm.environment.get('extraEpc').toUpperCase());",
              "  pm.environment.set('currentVersion', String(json.version));",
              "  pm.environment.set('etag', pm.response.headers.get('ETag'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Mobile revokes the physical test EPC",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{mobileToken}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"{{revokeRequestId}}\",\n  \"expectedVersion\": {{currentVersion}},\n  \"epcs\": [\"{{authorizedEpc}}\"],\n  \"reason\": \"POSTMAN_TEST_REVOCATION\",\n  \"requestedBy\": \"postman-operator\",\n  \"completeBatch\": false\n}"
        },
        "url": "{{baseUrl}}/api/v1/mobile/middleware/{{middlewareId}}/manifests/{{manifestId}}/revoke",
        "description": "Revokes the EPC that was initially authorized so a later physical scan must alarm."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Revoke created an active next version', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('ACTIVE');",
              "  pm.expect(json.revokedEpcs).to.include(pm.environment.get('authorizedEpc').toUpperCase());",
              "  pm.environment.set('currentVersion', String(json.newVersion));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Middleware downloads revoked version",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{middlewareToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [
          { "key": "If-None-Match", "value": "{{etag}}" }
        ],
        "url": "{{baseUrl}}/api/v1/middleware/{{middlewareId}}/manifest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Revoked version excludes the physical EPC', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('ACTIVE');",
              "  pm.expect(json.items.map(function (item) { return item.epc; })).not.to.include(pm.environment.get('authorizedEpc').toUpperCase());",
              "  pm.environment.set('currentVersion', String(json.version));",
              "  pm.environment.set('etag', pm.response.headers.get('ETag'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Mobile completes the manifest",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{mobileToken}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"requestId\": \"{{completeRequestId}}\",\n  \"expectedVersion\": {{currentVersion}},\n  \"note\": \"Completed from Postman\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/mobile/middleware/{{middlewareId}}/manifests/{{manifestId}}/complete"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Complete created a completed next version', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('COMPLETED');",
              "  pm.environment.set('currentVersion', String(json.newVersion));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Middleware downloads completion directive",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{middlewareToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [
          { "key": "If-None-Match", "value": "{{etag}}" }
        ],
        "url": "{{baseUrl}}/api/v1/middleware/{{middlewareId}}/manifest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Completion directive is empty and newer', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('COMPLETED');",
              "  pm.expect(json.itemCount).to.eql(0);",
              "  pm.expect(json.items).to.have.length(0);",
              "  pm.expect(String(json.version)).to.eql(pm.environment.get('currentVersion'));",
              "  pm.environment.set('etag', pm.response.headers.get('ETag'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Wrong middleware token is rejected",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "wrong-token", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/middleware/{{middlewareId}}/manifest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Wrong middleware token returns 401', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
