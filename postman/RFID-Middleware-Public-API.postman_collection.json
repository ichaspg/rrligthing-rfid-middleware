      "type": "string"
    },
    {
      "key": "apiToken",
      "value": "REPLACE_WITH_RFID_API_TOKEN",
      "type": "string"
    },
    {
      "key": "manifestId",
      "value": "SJ-2611-0005",
      "type": "string"
    },
    {
      "key": "transportId",
      "value": "SJ-2611-0005",
      "type": "string"
    },
    {
      "key": "activeVersion",
      "value": "57",
